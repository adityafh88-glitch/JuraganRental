# Unreal Engine: folder yang dibuat ulang otomatis oleh editor/compiler
Binaries/
Intermediate/
Saved/
DerivedDataCache/
Build/*
# kecuali ikon aplikasi Android (dibuat Tools/make_logo.ps1, dipakai saat build APK)
!Build/Android/
Build/Android/*
!Build/Android/res/
.vs/
.idea/
.vscode/

# Plugin: folder build plugin juga dibuat ulang
Plugins/**/Binaries/
Plugins/**/Intermediate/

# File proyek IDE yang dibuat ulang dari .uproject
*.sln
*.slnx
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Hasil build / paket game
*.pdb
*.exe
*.dll
*.pak
Packaged/

# Sistem operasi
Thumbs.db
Desktop.ini
.DS_Store

# Cadangan otomatis Blender
*.blend1
*.blend2

# Rahasia penandatanganan Android (kunci upload dan kata sandinya)
*.keystore
*.jks
Config/Android/AndroidEngine.ini
